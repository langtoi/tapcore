#!/var/jb/bin/sh
# Runs after files are unpacked.
export PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin

[ "$1" = "configure" ] || exit 0

LIB=/var/jb/var/mobile/Library
SCRIPTS=$LIB/TapCore/Scripts
LEGACY=$LIB/AutoTouch/Scripts
mkdir -p "$LIB/TapCore"

# Move scripts from the legacy folder once, then leave a link there so absolute paths used
# by existing BAS projects keep working.
if [ -d "$LEGACY" ] && [ ! -L "$LEGACY" ]; then
    if [ ! -e "$SCRIPTS" ]; then
        mv "$LEGACY" "$SCRIPTS"
    else
        mv "$LEGACY" "$LEGACY.bak.$(date +%Y%m%d%H%M%S)"
    fi
fi
mkdir -p "$LIB/TapCore/Data"
mkdir -p "$SCRIPTS/Screenshots"
if [ ! -e "$LEGACY" ] && [ ! -L "$LEGACY" ]; then
    mkdir -p "$(dirname "$LEGACY")"
    ln -s "$SCRIPTS" "$LEGACY"
fi

# Install the bundled sv.lua; keep the previous copy as sv.lua.bak.
if [ -f "$SCRIPTS/sv.lua" ]; then
    cp -f "$SCRIPTS/sv.lua" "$SCRIPTS/sv.lua.bak"
fi
cp -f /var/jb/usr/share/tapcore/sv.lua "$SCRIPTS/sv.lua"

chown -R mobile:mobile "$LIB/TapCore" 2>/dev/null || true

rm -f /tmp/tapcore.port
launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.tapcore.daemon.plist >/dev/null 2>&1 || \
    launchctl load -w /var/jb/Library/LaunchDaemons/com.tapcore.daemon.plist >/dev/null 2>&1 || true

uicache -p /var/jb/Applications/TapCore.app >/dev/null 2>&1 || true
exit 0
